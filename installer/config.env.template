# ─────────────────────────────────────────────────────────────────────────────
# Akashvani Workflow — local configuration
#
# This file sits next to Akashvani.exe in your install folder
# (e.g. C:\Program Files\Akashvani Workflow\config.env).
#
# After editing, fully close the app (and any Akashvani.exe process in Task
# Manager), then launch it again from the Start menu so changes take effect.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Google OAuth2 ──────────────────────────────────────────────────────────
# These are filled in by the installer, so on a normal install you do NOT need
# to touch them — launch the app, click "Authorize Google Drive", and sign in
# with the Google account that owns the Drive folder.
#
# They are blank in this template because it is tracked in a PUBLIC git
# repository; the real values are supplied at build time from the environment
# or server\.env, exactly like the Sarvam and Anthropic keys. See
# scripts/build-installer.mjs.
#
# Set them yourself only if you want the app to run under YOUR OWN Google
# Cloud project. To create one:
#   1. Go to https://console.cloud.google.com/
#   2. Create a project, enable the Google Drive API.
#   3. APIs & Services → Credentials → Create → OAuth 2.0 Client ID (Web app).
#   4. Authorized redirect URI EXACTLY:
#         http://localhost:3001/api/auth/google/callback
#   5. Paste your new ID and secret over the values below.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback


# ─── Google Drive (optional) ─────────────────────────────────────────────────
# Leave both blank to let the app create a top-level folder for you on first
# upload. Set GOOGLE_DRIVE_FOLDER_ID if you want to target a specific shared
# folder you've already created — paste the ID from the Drive folder URL.

GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME=Akashvani Episodes


# ─── Server ──────────────────────────────────────────────────────────────────
# The local port Akashvani listens on. The redirect URI above also uses this
# port — if you change it, update the Google Cloud Console redirect URI too.

PORT=3001


# ─── Watermark (optional) ────────────────────────────────────────────────────
# A default watermark image ships with the app (resources\watermark.png) and
# is used automatically — you don't need to set anything here.
#
# The bundled PNG is exported from Premiere with the rotation and alpha
# already baked in. Hence:
#   WATERMARK_ROTATE=0   → DO NOT rotate again (would double-rotate)
#   WATERMARK_OPACITY=1.5 → small alpha boost so it shows over dark footage
#
# To use a different watermark, point WATERMARK_FILE_PATH at any .png/.jpg.
# To disable image watermarks entirely (text-only), put a non-existent path.

WATERMARK_FILE_PATH=
WATERMARK_TEXT=WAVES OTT FOR SLC
WATERMARK_OPACITY=1.5
WATERMARK_ANGLE_RAD=-PI/8
WATERMARK_ROTATE=0


# ─── Encoding (advanced) ─────────────────────────────────────────────────────
# Set ENCODE_MODE=2pass for slightly higher quality at the cost of ~2x encode
# time. Leave blank for the fast default (single-pass VBR).

ENCODE_MODE=


# ─── Automatic subtitles (Sarvam) ────────────────────────────────────────────
# The app transcribes each episode itself instead of anyone going out to a
# separate transcription tool. Paste the Sarvam API subscription key below —
# without it the "Generate subtitles" step is switched off and the editor has
# to upload an .srt by hand.
#
# Get a key from https://dashboard.sarvam.ai/ (Settings → API keys).
#
# SARVAM_MODEL / SARVAM_LANGUAGE are optional. Defaults are saaras:v3 and
# hi-IN. Set SARVAM_LANGUAGE to a different BCP-47 tag (bn-IN, ta-IN, te-IN,
# mr-IN ...) for other languages, or to "unknown" to auto-detect — but note
# auto-detect misreads short lines and has returned the wrong script, so lock
# it to the episode's language whenever you know it.

SARVAM_API_KEY=
SARVAM_MODEL=
SARVAM_LANGUAGE=


# ─── Roman script (Anthropic / Claude) ───────────────────────────────────────
# Converting the finished subtitles into Roman letters is done by Claude. With
# no key here the "Convert to Roman script" step is switched off; everything
# else in the app still works.
#
# Get a key from https://console.anthropic.com/ (Settings → API keys).

ANTHROPIC_API_KEY=

# Optional. Defaults are claude-opus-5-5 and low effort, which is the right
# setting for transliteration: it is mechanical and format-sensitive, so extra
# reasoning costs money without improving the result.

ROMANIZE_MODEL=
ROMANIZE_EFFORT=


# ─── Romanization dictionaries ───────────────────────────────────────────────
# PlanetRead's agreed spellings live in one Google Doc per language, which the
# language experts edit directly. Akashvani reads them through the Google
# account signed in on the machine, so the docs do NOT need to be shared
# publicly — share them with that account and nothing more.
#
# Paste the Google Docs link for each language you work in. An editor can also
# set these from the "Convert to Roman script" step without touching this file;
# anything set there wins over the value here.
#
# Leave a language blank and its subtitles are still converted to Roman script,
# just without the agreed spellings applied.

DICTIONARY_DOC_URL_HINDI=
DICTIONARY_DOC_URL_BENGALI=
DICTIONARY_DOC_URL_PUNJABI=
DICTIONARY_DOC_URL_MARATHI=
DICTIONARY_DOC_URL_TAMIL=
DICTIONARY_DOC_URL_TELUGU=
DICTIONARY_DOC_URL_KANNADA=
DICTIONARY_DOC_URL_GUJARATI=
DICTIONARY_DOC_URL_MALAYALAM=
DICTIONARY_DOC_URL_ODIA=
